# Stage 1: Base PHP image
FROM php:8.4-fpm AS base

# PHP configuration
RUN echo "upload_max_filesize = 100M" > /usr/local/etc/php/conf.d/uploads.ini \
    && echo "post_max_size = 100M" >> /usr/local/etc/php/conf.d/uploads.ini \
    && echo "max_execution_time = 300" >> /usr/local/etc/php/conf.d/uploads.ini \
    && echo "max_input_time = 300" >> /usr/local/etc/php/conf.d/uploads.ini \
    && echo "memory_limit = 512M" >> /usr/local/etc/php/conf.d/uploads.ini

RUN apt-get update \
    && apt-get install -y \
        libpng-dev \
        libonig-dev \
        libxml2-dev \
        libicu-dev \
        libzip-dev \
        zip \
        unzip \
        git \
        curl \
        default-mysql-client \
    && docker-php-ext-install \
        pdo \
        pdo_mysql \
        intl \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html


# Stage 2: Install PHP dependencies
FROM base AS composer

COPY ./src/composer.json ./src/composer.lock ./

RUN composer install \
    # --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts


# Stage 3: Build Vite assets
FROM node:22 AS frontend

WORKDIR /app

# Install Node dependencies first for Docker layer caching
COPY ./src/package.json ./src/package-lock.json ./
RUN npm ci

# Copy Laravel source
COPY ./src/ .
COPY --from=composer /var/www/html/vendor ./vendor

# Build production assets
RUN npm run build


# Stage 4: Production Laravel image
FROM base AS production

WORKDIR /var/www/html

ENV APP_ENV=production
ENV APP_DEBUG=false

# Copy Laravel application
COPY ./src/ .

# Remove development-generated Laravel caches
RUN rm -f bootstrap/cache/*.php

# Copy Composer dependencies
COPY --from=composer \
    /var/www/html/vendor \
    ./vendor

# Copy Vite production build
COPY --from=frontend \
    /app/public/build \
    ./public/build

# Prepare Laravel directories
RUN mkdir -p \
        storage/app/public \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache

# Permissions
RUN chown -R www-data:www-data \
        storage \
        bootstrap/cache

# Remove files unnecessary at runtime
RUN rm -rf \
        node_modules \
        tests \
        .git

# PHP-FPM
EXPOSE 9000

# CMD ["sh", "-c", "php artisan storage:link || true && php artisan migrate --force && php artisan config:cache && php artisan route:cache && php artisan view:cache && php-fpm"]
COPY docker/php/prod-entrypoint.sh /usr/local/bin/prod-entrypoint.sh
RUN chmod +x /usr/local/bin/prod-entrypoint.sh

CMD ["prod-entrypoint.sh"]